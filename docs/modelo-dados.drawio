        <mxCell id="lc_7" parent="lc" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" value="created_at : DATETIME(6)" vertex="1"><mxGeometry height="24" width="360" y="222" as="geometry" /></mxCell>
        <mxCell id="lc_note" parent="1" style="text;html=1;align=left;fontSize=10;fontColor=#666666;fontStyle=2;" value="INDEX (ticket_id), INDEX (created_at)&#xa;1 linha por chamada de LLM — 1 por investigação na v1, 2 na v2 (agente = ANALISTA | SOLUCAO)&#xa;custo_estimado_usd = tokens × preço-da-época (price map em config) — snapshot, custo histórico estável&#xa;a GCP/Vertex retorna tokens, NÃO dinheiro" vertex="1">
