        <mxCell id="tk_18" parent="tk" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontColor=#666666;" value="ultima_ocorrencia_ts : DATETIME(6)  /  contagem_ocorrencias : INT" vertex="1"><mxGeometry height="24" width="380" y="574" as="geometry" /></mxCell>
        <mxCell id="tk_note" parent="1" style="text;html=1;align=left;fontSize=10;fontColor=#666666;fontStyle=2;" value="UNIQUE (app, tipo_erro, chave_dedup, data) — sustenta o dedup (INSERT ... ON DUPLICATE KEY UPDATE)&#xa;INDEX (status), INDEX (data) — pro TicketController&#xa;+ orcamento_debitado : BOOLEAN (idempotência do débito de orçamento)&#xa;status: EM_INVESTIGACAO | ABERTO | CAUSA_INCONCLUSIVA | INVESTIGACAO_PULADA_ORCAMENTO_EXCEDIDO |&#xa;  INVESTIGACAO_FALHOU_PARSING | INVESTIGACAO_FALHOU_INFRA | INVESTIGACAO_DESABILITADA | RESOLVIDO&#xa;causa_categoria: INFRA_RECURSO | INFRA_REDE | DEPENDENCIA_DOWNSTREAM | CONFIGURACAO | CODIGO | INDETERMINADA" vertex="1">
          <mxGeometry height="100" width="620" x="40" y="1000" as="geometry" />
        </mxCell>

