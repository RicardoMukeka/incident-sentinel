        <mxCell id="wm_note" parent="1" style="text;html=1;align=left;fontSize=9;fontColor=#666666;fontStyle=2;" value="watermark = MAX(timestamp) FROM error_signal_log POR app+tipo_erro&#xa;desde = max(watermark − overlap, agora − maxLookback); fallback agora−1h se vazio&#xa;sem UPDATE de watermark — leitura pura, recalculado ao vivo" vertex="1">
