        <mxCell id="mysql" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" value="MySQL (Liquibase, 5 tabelas) — timezone UTC em toda a stack&#xa;• app_registry (heartbeat ultima_execucao_*)&#xa;• error_signal_log (INDEX app+tipo_erro+timestamp — fonte do watermark; trace_id nullable; sem purga v1)&#xa;• investigation_budget (dia PK/UTC, contador, tokens_acumulados, custo_acumulado_usd)&#xa;• ticket (UNIQUE app+tipo_erro+chave_dedup+data; causa_*/confianca_*/solucao_*; feedback humano avaliacao_*/*_efetiva grava-não-lê;&#xa;   status: EM_INVESTIGACAO|ABERTO|CAUSA_INCONCLUSIVA|INVESTIGACAO_PULADA_ORCAMENTO_EXCEDIDO|_FALHOU_PARSING|_FALHOU_INFRA|_DESABILITADA|RESOLVIDO)&#xa;• investigation_llm_call (1 linha/chamada — 1 na v1, 2 na v2; tokens + custo_estimado_usd snapshot)" vertex="1">
          <mxGeometry height="160" width="900" x="-490" y="2290" as="geometry" />
        </mxCell>
        <mxCell id="obs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" value="Observabilidade (Micrometer + /actuator/prometheus)&#xa;• incidentsentinel.collector.cycle.duration (Timer)&#xa;• incidentsentinel.triage.signal.failure (Counter, tag app+tipo_erro)&#xa;• incidentsentinel.investigation.outcome (Counter, tag outcome = TicketStatus)&#xa;• incidentsentinel.investigation.retriever (Counter, tags retriever + outcome)&#xa;• incidentsentinel.investigation.prompt.truncated / .prompt.redacted (Counter)&#xa;• tokens.acumulados / custo.acumulado.usd (Gauge — LIDO do banco, não in-memory)&#xa;• resilience4j-micrometer (por fonte: signoz / tsuru-mcp / gcp-logging / vertex-ai)&#xa;• alertas: coletor parado / orçamento estourado (contagem ou custo) / fonte indisponível / prompt.redacted &gt; 0" vertex="1">
          <mxGeometry height="188" width="760" x="-490" y="2470" as="geometry" />
